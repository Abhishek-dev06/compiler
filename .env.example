# A Judge0 CE-compatible base URL. The public CE endpoint is suitable for demos;
# use your own secured deployment for production.
JUDGE0_API_URL=https://ce.judge0.com
# Judge0 CE's documented Multi-file program language. Set empty to disable
# automatic support for Java public classes other than Main.
JUDGE0_JAVA_MULTIFILE_LANGUAGE_ID=89

# Optional credentials for a secured Judge0 CE deployment. Never commit .env.
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_USER=
# JUDGE0_API_KEY= is also accepted as a backwards-compatible token alias.

# REQUIRED in production (Render sets RENDER=true, and the app refuses to start without it).
# Signs session cookies, so use a long random value and never commit it:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Optional locally: when empty, a temporary random key is used and sessions reset on restart.
SECRET_KEY=
# Session cookies are Secure by default when RENDER=true or APP_ENV=production, and not otherwise.
# Set to false only to test a production-mode build over plain http locally.
# SESSION_COOKIE_SECURE=
# APP_ENV=production
# TRUST_PROXY defaults to on in production so Flask honours the HTTPS proxy's X-Forwarded-* headers.
# TRUST_PROXY=

# Optional application settings
PORT=5000
FLASK_DEBUG=false
JUDGE0_REQUEST_TIMEOUT=15
JUDGE0_POLL_INTERVAL=0.75
JUDGE0_MAX_WAIT=25
HISTORY_LIMIT=100
# DATABASE_PATH=C:/absolute/path/to/coderun.db
